# Kitchen / staff portal password (required in production)
ADMIN_PASSWORD=change-me

# Durable order store. Docker/Railway should set this to the volume mount.
# Local `npm run dev` can leave this unset (uses ./data/db.json).
# DATA_DIR=/data

# Hostnames that serve the kitchen portal (comma-separated).
# Example: your Railway URL, or kitchen.gebetacater.com
# When set, other hosts return 404 for /admin (customer storefront).
# Leave unset locally so /admin works on localhost.
# KITCHEN_HOST=gebeta-production.up.railway.app

# Public customer site URL used in SMS / order notice links.
# Example: https://gebetacater-production.up.railway.app
# PUBLIC_APP_URL=https://gebetacater-production.up.railway.app
